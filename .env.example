# Copy to .env and fill in. NEVER commit .env. Never print or log these values.

# Claude Console API key (class organization, shared credits)
ANTHROPIC_API_KEY=

# Jev model access (set when milestone 3 says how)
JEV_API_KEY=

# Cost and safety limits
MODEL_CALLS_ENABLED=true        # false = kill switch, rules-only fallback
MAX_TOKENS_PER_RUN=20000
MAX_TOKENS_PER_DAY=500000

# Generator
GENERATOR_MINUTES=10            # demo-length runs only
